<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories | FreshCart</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar"> 

    <div class="logo">
        <i class="fa-solid fa-cart-shopping"></i>
        <h2>FreshCart</h2>
    </div>

    <div class="nav-links">
        <a href="/"><i class="fa-solid fa-house"></i>Home</a>
        <a href="/products"> <i class="fa-solid fa-box-open"></i>Products</a>
        <a href="/categories"><i class="fa-solid fa-table-cells-large"></i>Categories</a>
    </div>

    <form action="/products" method="GET" class="search-bar">

    <input
        type="text"
        name="search"
        placeholder="Search groceries..."
    >

    <button type="submit">
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>

</form>
    <div class="nav-icons">

    <% if(user){ %>

        <a href="/account">
            <i class="fa-regular fa-user"></i>
            <%= user.name %>
        </a>

    <% } else { %>

        <a href="/login">
            <i class="fa-regular fa-user"></i>
            Login
        </a>

    <% } %>

    <a href="/cart">
        <i class="fa-solid fa-cart-shopping"></i>
        Cart
    </a>

</div>

    </nav>
    <section class="categories-page">

    <div class="section-title">
        <h2>Shop by Categories</h2>
        <p>Choose your favorite grocery category.</p>
    </div>

    <div class="category-grid">

    <% categories.forEach(category => { %>

        <div class="category-card">

            <img
                src="/images/<%= category.image %>"
                alt="<%= category.category_name %>"
            >

            <h3>
                <%= category.category_name %>
            </h3>

        </div>

    <% }) %>

</div>

    <!-- ================= Footer ================= -->

    <footer class="footer">

    <div class="footer-container">

        <div class="footer-about">
            <h2>FreshCart</h2>
            <p>
                Fresh groceries delivered to your doorstep with quality,
                affordability, and convenience.
            </p>
        </div>

        <div class="footer-links">
            <h3>Quick Links</h3>

            <a href="/">Home</a>
            <a href="/products">Products</a>
            <a href="/categories">Categories</a>
            <a href="/cart">Cart</a>
        </div>

        <div class="footer-contact">

            <h3>Contact</h3>

            <p>Email : support@freshcart.com</p>
            <p>Phone : +91 9876543210</p>
            <p>Location : India</p>

        </div>

    </div>

    <hr>

    <p class="copyright">
        © 2026 FreshCart. All Rights Reserved.
    </p>

    </footer>

</body>
</html>
